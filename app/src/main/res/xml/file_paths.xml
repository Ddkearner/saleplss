<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Grants access to the base APK package directory so it can be shared via Intent -->
    <root-path name="root" path="." />
    <!-- Grants access to cache directory for temporary copied APKs -->
    <cache-path name="apk_cache" path="shared_apk/" />
</paths>
